# Copy to .env and adjust. Everything here is read and validated in src/config/env.ts.

# PostgreSQL (docker compose up -d db  -> this URL works as is)
DATABASE_URL=postgres://carfranko:carfranko@localhost:5433/carfranko

# Providers to run, comma-separated: iaai-web, copart-web
# copart-web currently stops on Copart's bot challenge (see docs/RESEARCH.md); keep it to get notified if that changes.
PROVIDERS=iaai-web,copart-web

# Filter sets: which lots we import (copy config/filters.example.json to config/filters.json)
FILTERS_FILE=./config/filters.json

# We identify ourselves honestly. Put a real contact URL or email here.
HTTP_USER_AGENT=CarFrankoLotSync/0.1 (+https://github.com/GritsenkoIvanKPI/car-franko)
HTTP_TIMEOUT_MS=30000

# IAAI's official sitemap index (lot discovery). Change only if IAAI moves it.
IAAI_SITEMAP_INDEX_URL=https://www.iaai.com/Xj9rDOVMEi0hc38S/sitemap_index.xml

# Website folder (photos -> SITE_ROOT/images/cars, site data -> SITE_ROOT/data/lots.json)
SITE_ROOT=..

# Gap between requests to one source: random between min and max (ms). Never below 1000.
RATE_LIMIT_MIN_MS=2000
RATE_LIMIT_MAX_MS=3000

# --- added in later steps ---
# Step 3: SYNC_INTERVAL_MINUTES, HIDE_AFTER_DAYS
# Step 4: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
